# Dépendances Node.js (réinstallées via `npm install`)
node_modules/
.npm/

# Build / packaging
dist/
*.zip

# Paramètres locaux Azure Functions (contiennent des secrets / chaînes de connexion)
# -> un modèle versionné est fourni : local.settings.example.json
local.settings.json

# Variables d'environnement
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Azurite (émulateur de stockage local)
.azurite/
__blobstorage__/
__queuestorage__/
__tablestorage__/
__azurite_db*__.json
AzuriteConfig

# Tests / couverture
coverage/
TestResults/

# Éditeurs (on garde uniquement les recommandations d'extensions VS Code)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini
